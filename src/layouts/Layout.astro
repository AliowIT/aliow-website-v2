---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-primary">
  <head>
    <title>{title}</title>
    <!-- meta tags -->
    <meta charset="UTF-8" />
    <meta name="description" content="From vision to value: low-code strategies that work" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#021d33" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="aliow">
    <meta name="generator" content={Astro.generator} />
    <!-- icon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body class="font-host-grotesk text-xl text-primary">
    <Header />
    <slot />
    <Footer />
    <script>
      import "../scripts/navigation.js";
      import "../scripts/header.js";
      import "../scripts/contact.js";
    </script>
  </body>
</html>
