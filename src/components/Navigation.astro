---
import Hamburger from "./Hamburger.astro";
import Menu from "./Menu.astro";
import Close from "./Close.astro";
---

<nav class="z-100">
  <!-- Desktop variant -->
  <div class="flex items-center">
    <Hamburger />
    <Menu variant="desktop" />
  </div>
  <!-- Mobile modal -->
  <div
    id="mobile-menu"
    class="bg-primary/85 backdrop-blur fixed top-0 right-0 h-screen w-screen transform translate-x-full transition-transform duration-300 ease-in-out md:hidden"
    aria-modal="true"
  >
    <div class="absolute right-0 top-0 flex items-center p-6">
      <Close />
    </div>
    <Menu variant="mobile" />
  </div>
</nav>
