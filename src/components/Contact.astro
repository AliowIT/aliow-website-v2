---
import { Image } from "astro:assets";
import Section from "./Section.astro";
import spinner from "../assets/infinite-spinner.svg";
import BaseCard from "./BaseCard.astro";
import Link from "./Link.astro";
import Input from "./Input.astro";
import TextArea from "./TextArea.astro";
import Button from "./Button.astro";
const title = "Get in touch";
const description =
  "Are you looking for a partner or interested in knowing more? Contact us by sending a message or through the alternative contacts.";
---

<Section
  id="contact"
  primary
  title={title}
  description={description}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
    <!-- Contact form -->
    <div class="md:order-1">
      <BaseCard variant="glass" title="Send us a message">
        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          id="form"
          class="needs-validation flex flex-col gap-12"
          data-astro-reload
          novalidate
        >
          <!-- web3forms access key -->
          <input
            type="hidden"
            name="access_key"
            value="53b513f3-c293-46d7-85b2-847522ce33f3"
          />

          <input
            type="hidden"
            name="subject"
            value="Contact Form Request"
          />
          <input
            type="hidden"
            name="from_name"
            value="aliow"
          />

          <!-- Honeypot spam protection -->
          <input
            type="checkbox"
            class="hidden"
            style="display:none"
            name="botcheck"
          />

          <!-- Name input -->
          <Input
            id="name"
            label="Name"
            type="text"
            required
            autocomplete="name"
            feedback="Please enter your name."
          />

          <!-- Email input -->
          <Input
            id="email"
            label="Email address"
            type="email"
            required
            autocomplete="email"
            feedback="Please enter a valid email address."
          />

          <!-- Message textarea -->
          <TextArea
            id="message"
            label="Message"
            required
            feedback="Please enter your message."
          />

          <!-- Submit button -->
          <div class="flex flex-col gap-6">
            <Button
              id="submit"
              type="submit"
            >
              <span class="flex gap-2">
                <Image
                  src={spinner}
                  width={30}
                  id="spinner"
                  class="hidden"
                  alt="Spinner indicator"
                />
                Send message
              </span>
            </Button>

            <!-- Feedback message -->
            <div id="result"></div>
          </div>
        </form>
      </BaseCard>
    </div>

    <!-- Alternative contacts -->
    <div class="flex flex-col gap-12">
      <div class="grid grid-cols-1 xl:grid-cols-2 gap-12">
        <!-- Phone -->
        <BaseCard variant="glass" title="Phone">
          <Link href="tel:937912271">+351 937 912 271</Link>
        </BaseCard>

        <!-- Email -->
        <BaseCard variant="glass" title="Email">
          <Link href="mailto:info@aliow.it">info@aliow.it</Link>
        </BaseCard>
      </div>

      <!-- Address -->
      <BaseCard variant="glass" title="Address">
        <div>
          <p>Rua São Sebastião da Pedreira 55 1º Dto</p>
          <p>1050-206 Lisboa, Portugal</p>
        </div>
        <Link
          href="https://maps.app.goo.gl/298hApzNPyRPoPc5A"
          target="_blank"
          class="mt-6"
        >
          Open in Google Maps
        </Link>
      </BaseCard>
    </div>
  </div>
</Section>
