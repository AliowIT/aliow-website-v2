---
const {
  href,
  target,
  rel,
  class: extra = "",
  ...rest
} = Astro.props;
---

<a
  href={href}
  target={target}
  rel={rel ?? (target === "_blank" ? "noopener noreferrer" : undefined)}
  class={`p-3 border border-white/10 rounded-full bg-white/15 hover:bg-white/75 active:bg-white/40 fill-white hover:fill-primary active:scale-95 transition ${extra}`}
  ontouchstart=""
  {...rest}
>
  <slot />
</a>



