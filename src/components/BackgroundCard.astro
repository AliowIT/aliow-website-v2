---
import { Image } from "astro:assets";

const { bgImg, alt } = Astro.props;
---

<div class="relative text-xl sm:text-2xl rounded">
  <Image src={bgImg} alt={alt} class="absolute h-full w-full object-cover object-center rounded"/>
  <div
    class="px-6 py-12 md:py-24 text-white bg-primary/75 h-full backdrop-blur-xs grid grid-cols-1 md:grid-cols-2 items-center rounded"
  >
    <div>
      <slot />
    </div>
  </div>
</div>
