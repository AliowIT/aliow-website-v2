---
import Section from "../components/Section.astro";
import BaseCard from "./BaseCard.astro";
const title = "Why us";
const description =
  "Partnering with us means more than just a service, it’s a commitment to your success. We transform your ideas into reality through expert-driven solutions, cutting-edge technology, and strategic collaboration.";

const cardItems = [
  {
    title: "Expertise that delivers",
    description:
      "Great solutions come from great minds. Our team consists of industry leaders who combine deep expertise with a passion for innovation, ensuring excellence in every project.",
  },
  {
    title: "Partnership beyond projects",
    description:
      "We don’t just deliver, we collaborate. Our approach is built on trust, transparency, and long-term relationships that drive mutual growth and success.",
  },
  {
    title: "Smart, flexible solutions",
    description:
      "Your challenges shape our approach. We select the best low-code technology for your needs—efficient, adaptable, and built for results",
  },
];
---

<Section
  id="why"
  primary
  title={title}
  description={description}
>
  <div
    class="grid grid-cols-1 md:grid-cols-3 gap-12"
  >
    {
      cardItems.map((item) => {
        return (
          <BaseCard
            variant="glass"
            title={item.title}
            description={item.description}
          />
        );
      })
    }
  </div>
</Section>
