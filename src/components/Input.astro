---
const {
  id,
  label,
  type,
  required = false,
  autocomplete = "",
  maxlength = 100,
  feedback = "",
} = Astro.props;
---

<div class="flex flex-col gap-2">
  <!-- Label -->
  <label
    for={id}
    class="font-semibold"
  >
    {label}
  </label>

  <!-- Input -->
  <input
    id={id}
    type={type}
    name={id}
    required={required}
    autocomplete={autocomplete}
    maxlength={maxlength}
    class="text-white bg-white/15 border border-white/10 p-2 rounded"
  />

  <!-- Feedback message -->
  <div class="empty-feedback invalid-feedback text-red-400 text-sm">
    {feedback}
  </div>
</div>
