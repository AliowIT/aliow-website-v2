---
const {
  id,
  label,
  type = "text",
  required = false,
  autocomplete = "",
  maxlength = 100,
  feedback = "",
  class: extra = "",
  ...rest
} = Astro.props;
---

<div class="flex flex-col gap-2">
  <!-- Label -->
  {
    label && (
      <label
        for={id}
        class="font-semibold"
      >
        {label}
      </label>
    )
  }

  <!-- Input -->
  <input
    id={id}
    type={type}
    name={id}
    required={required}
    autocomplete={autocomplete}
    maxlength={maxlength}
    aria-describedby={feedback ? `${id}-feedback` : undefined}
    class={`form-input ${extra}`}
    {...rest}
  />

  <!-- Feedback message -->
  {
    feedback && (
      <div
        id={`${id}-feedback`}
        class="empty-feedback invalid-feedback text-red-400 text-sm"
      >
        {feedback}
      </div>
    )
  }
</div>
