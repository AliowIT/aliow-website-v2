---
const { variant = "desktop" } = Astro.props;
const isMobile = variant === "mobile";
const menuItems = [
  { name: "How can we help", href: "#how" },
  { name: "Why us", href: "#why" },
  { name: "Who we are", href: "#who" },
  { name: "Contact us", href: "#contact" },
];
---

<ul
  class={isMobile
    ? "h-screen flex flex-col gap-y-12 items-center justify-center"
    : "hidden md:flex gap-x-12"}
>
  {
    menuItems.map((item, index) => (
      <li>
        <a
          href={item.href}
          class={
            isMobile
              ? "hover:text-secondary transition mobile-menu-link"
              : "hover:text-secondary transition"
          }
          {...(isMobile ? { "data-index": index, tabindex: "-1" } : {})}
        >
          {item.name}
        </a>
      </li>
    ))
  }
</ul>
