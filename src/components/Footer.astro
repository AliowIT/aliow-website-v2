---
import IconButton from "./IconButton.astro";
import IconX from "./icons/IconX.astro";
import IconLinkedIn from "./icons/IconLinkedIn.astro";
import Copyright from "./Copyright.astro";
---

<footer class="px-6 sm:px-12 py-6 text-white">
  <div
    class="flex flex-col gap-y-6 items-center sm:flex-row sm:justify-between"
  >
    <Copyright />
    <div class="flex items-center gap-3">
      <IconButton href="https://x.com/aliow_it">
        <IconX />
      </IconButton>
      <IconButton href="https://linkedin.com/company/aliow">
        <IconLinkedIn />
      </IconButton>
    </div>
  </div>
</footer>
