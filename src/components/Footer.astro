---
import IconLink from "./IconLink.astro";
import Copyright from "./Copyright.astro";
import Icon from "./Icon.astro";
---

<footer class="px-6 sm:px-12 py-6 text-white">
  <div
    class="flex flex-col gap-y-6 items-center sm:flex-row sm:justify-between"
  >
    <Copyright />
    <div class="flex items-center gap-3">
      <IconLink href="https://x.com/aliow_it" target="_blank">
        <Icon name="x" />
      </IconLink>
      <IconLink href="https://linkedin.com/company/aliow" target="_blank">
        <Icon name="linkedin" />
      </IconLink>
    </div>
  </div>
</footer>
