---
const {
  href,
  target,
  rel,
  class: extra = "",
  ...rest
} = Astro.props;
---

<a
  href={href}
  target={target}
  rel={rel ?? (target === "_blank" ? "noopener noreferrer" : undefined)}
  class={`w-fit border-b py-1 hover:text-secondary transition inline-block ${extra}`}
  ontouchstart=""
  {...rest}
>
  <slot />
</a>
