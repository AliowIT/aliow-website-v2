---
import { Image } from "astro:assets";

const { title, description, icon, alt, height = 100 } = Astro.props;
---

<div
  class="p-6 bg-primary/3 border border-primary/4 rounded flex flex-col gap-y-6"
>
  <div>
    <Image src={icon} alt={alt} height={height}/>
  </div>
  <h3 class="font-semibold text-xl sm:text-2xl">{title}</h3>
  <p>{description}</p>
</div>
