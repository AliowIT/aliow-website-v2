---
const { id, primary = false, title, description } = Astro.props;
---

<section
  id={id}
  class={"px-6 sm:px-12 py-12 md:py-24 scroll-mt-20 " +
    (primary ? " text-white bg-primary" : "bg-white")}
>
  <div class="max-w-7xl mx-auto flex flex-col gap-y-12">
    <div class="flex flex-col gap-y-6 sm:w-2/3 lg:w-1/2">
      <h2 class="font-bold text-3xl sm:text-5xl lg:text-6xl">{title}</h2>
      <p class="sm:text-2xl">{description}</p>
    </div>
    <slot />
  </div>
</section>
