---
const {
  id,
  type = "button",
  variant = "secondary", // primary | secondary
  class: extra = "",
  disabled = false,
  ...rest
} = Astro.props;
---

<button
  id={id}
  type={type}
  class={`btn btn-${variant} ${extra}`}
  disabled={disabled}
  ontouchstart=""
  {...rest}
>
  <slot />
</button>
